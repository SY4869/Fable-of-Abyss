# 対戦サーバーの設定例。コピーして .env を作成してください（.env はコミットしない）。
#   cp .env.example .env

# 待ち受けポート（nginx から http://127.0.0.1:3000 へ転送する）
PORT=3000
HOST=127.0.0.1

# 接続を許可する接続元（カンマ区切り）。www を使う場合は https://www.sygames.net も追加
ALLOWED_ORIGINS=https://sygames.net

# ログの詳細度: debug / info / warn / error
LOG_LEVEL=info
